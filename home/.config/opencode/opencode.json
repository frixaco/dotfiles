{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--no-usage-statistics",
          "--browserUrl",
          "http://127.0.0.1:9222"
        ],
        "disabled": false
      }
    }
  },
  "model": "openai/gpt-6-astra",
  "agents": {
    "title": {
      "model": "openai/gpt-6-astra"
    }
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "settings": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  }
}
