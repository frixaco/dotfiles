{
  "$schema": "https://opencode.ai/config.json",
  "lsp": false,
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--no-usage-statistics",
        "--browserUrl",
        "http://127.0.0.1:9222"
      ],
      "enabled": true
    }
  },
  "model": "openai/gpt-6-astra",
  "small_model": "openai/gpt-6-astra",
  "provider": {
    "openai": {
      "models": {
        "gpt-6-astra": {
          "options": {
            "reasoningEffort": "medium"
          }
        }
      }
    }
  }
}
